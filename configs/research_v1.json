{
  "version": "research_v1",
  "seed": 42,
  "dataset": {
    "name": "mandarjoshi/trivia_qa",
    "config": "rc.wikipedia",
    "revision": "0f7faf33a3908546c6fd5b73a660e0f8ff173c2f",
    "train_candidates": 2000,
    "dev": 200,
    "test": 300,
    "exclude_legacy_from_validation": true,
    "chunk_words": 200,
    "overlap_words": 40,
    "max_chunks": 250000
  },
  "models": {
    "embedding": "sentence-transformers/all-MiniLM-L6-v2",
    "generator_base": "google-t5/t5-base",
    "extractive": "distilbert/distilbert-base-cased-distilled-squad"
  },
  "retrieval": {"top_k": 5, "pool": 30, "rrf_constant": 60, "context_top_n": 2},
  "generation": {"max_input_tokens": 512, "max_new_tokens": 32, "num_beams": 4, "length_penalty": 0.8, "no_repeat_ngram_size": 3},
  "training": {"epochs": 3, "micro_batch": 2, "gradient_accumulation": 8, "learning_rate": 0.0003, "weight_decay": 0.01},
  "evaluation": {"policies": ["official", "canonical"], "review_sample": 50, "retrieval_k": [1, 3, 5, 10]}
}
